{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fahmm",
  "version": "0.1.0",
  "identifier": "app.fahmm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run verify:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fahmm — Fah Meeting Minutes",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' http://fahmm.localhost; connect-src 'self' http://fahmm.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/fahmm-sidecar"],
    "windows": {
      "nsis": {
        "installerIcon": "icons-fahmm/icon.ico",
        "uninstallerIcon": "icons-fahmm/icon.ico"
      }
    },
    "icon": [
      "icons-fahmm/32x32.png",
      "icons-fahmm/128x128.png",
      "icons-fahmm/128x128@2x.png",
      "icons-fahmm/icon.icns",
      "icons-fahmm/icon.ico"
    ]
  }
}
